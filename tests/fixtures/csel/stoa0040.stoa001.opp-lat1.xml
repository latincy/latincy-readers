    <body>
      <div type="edition" xml:lang="lat" n="urn:cts:latinLit:stoa0040.stoa001.opp-lat1">
        <div n="1" subtype="book" type="textpart">
          <ab><title type="sub">LIBER PRIMVS.</title></ab>
          <div n="1" subtype="section" type="textpart">
            <p>Magnus es, domine, et laudabilis valde: magna virtus tua et sapientiae tuae non est numerus.
            <note type="footnote">Ps. 144, 3.</note></p>
          </div>
          <div n="2" subtype="section" type="textpart">
            <p>Et quomodo invocabo deum meum, deum et dominum meum, quoniam utique in me ipsum eum invocabo.</p>
          </div>
        </div>
        <div n="2" subtype="book" type="textpart">
          <ab><title type="sub">LIBER SECVNDVS.</title></ab>
          <div n="1" subtype="section" type="textpart">
            <p>Recordari volo praeteritas foeditates meas et carnales corruptiones animae meae, non quod eas amem, sed ut amem te, deus meus.</p>
          </div>
          <div n="2" subtype="section" type="textpart">
            <p>Quid mihi erat in <supplied reason="lost">isto</supplied> furto et quid te, domine deus meus, imitari volui scelerate?</p>
          </div>
        </div>
      </div>
    </body>
